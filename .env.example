# Copia este archivo a .env.local y completa los valores.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "anon" / "publishable" (es pública; la protegen las políticas RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección final del sitio. Sin barra final. IMPORTANTE para aparecer en Google
# con el dominio propio: de aquí salen las direcciones canónicas, el sitemap y
# los datos estructurados. Ejemplo: https://edwinpatino.com
NEXT_PUBLIC_SITE_URL=

# Código de verificación de Google Search Console (método "etiqueta HTML").
# Solo el valor de content="...". Opcional.
GOOGLE_SITE_VERIFICATION=
